# Copy to .env and fill in. Never commit .env.

# --- Runtime ---------------------------------------------------------------
CONDUIT_ENV=development          # development | production
CONDUIT_LOG_LEVEL=INFO
CONDUIT_LOG_JSON=false           # true in production

# --- Telegram interface ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- itmano_crm adapter ----------------------------------------------------
# Thin authenticated endpoint on the CRM. CONDUIT never touches the CRM database.
# The token determines the tenant; no request ever carries a tenant identifier.
ITMANO_CRM_BASE_URL=
ITMANO_CRM_TOKEN=

# Startup assertion. The adapter calls /whoami and refuses to serve a single
# tool if either of these does not match. A misconfigured deployment must fail
# loudly, not quietly point at the wrong tenant.
ITMANO_CRM_EXPECTED_TENANT=
ITMANO_CRM_EXPECTED_ENVIRONMENT=sbx

# Ceiling only. Per-tool timeouts are read from x-itmano-deadline-ms in the
# published contract, so they cannot drift from what the server actually enforces.
ITMANO_CRM_TIMEOUT_SECONDS=15

# --- vibemarketolog adapter ------------------------------------------------
VIBEMARKETOLOG_BASE_URL=
VIBEMARKETOLOG_API_KEY=
VIBEMARKETOLOG_TIMEOUT_SECONDS=60

# --- Redis (kill switch, loop windows, sessions, idempotency) --------------
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL / pgvector (audit log, semantic dedup) ---------------------
DATABASE_URL=

# --- Guard rails -----------------------------------------------------------
GUARD_MAX_TOOL_CALLS_PER_TURN=8
GUARD_MAX_ACTIONS_PER_SESSION_HOUR=40
GUARD_LOOP_WINDOW_SECONDS=300
GUARD_LOOP_REPEAT_THRESHOLD=3
GUARD_KILL_SWITCH_KEY=conduit:kill_switch

# --- Cost governance -------------------------------------------------------
COST_SESSION_CEILING_USD=1.00
COST_DAILY_CEILING_USD=25.00
